## Environment variables set by revdepcheck.extras::run()
R_REVDEPCHECK_TIMEOUT=${R_REVDEPCHECK_TIMEOUT:-180}
TAR_SKIP_CLUSTERMQ=${TAR_SKIP_CLUSTERMQ-true}
R_PARALLELLY_AVAILABLECORES_FALLBACK=2 ## fall back to at least two workers

## https://github.com/futureverse/future/issues/821
R_FUTURE_GLOBALS_METHOD_DEFAULT="dfs"

